  "reviewer": "GPT-6 Codex; exact runtime identifier unavailable",
  "scope": "recognition requirements, not new positive oracle or whole-host deep acceptance",
  "generic_requirements": [
    {
      "id": "installed_entry",
      "requirement": "Prove a platform client setter attaches the concrete client to this actual WebView. Resolve virtual entry to installed receiver; a constructed but uninstalled client is insufficient."
    },
    {
      "id": "capture_identity",
      "requirement": "Prove constructor/field copies from the concrete script allocation through client -> router -> final target field. Same-class distinct allocation is not same-object."
    },
    {
      "id": "input_provenance",
      "requirement": "Prove message JSON provides method, types and args to this entry; preserve any protocol prefix, URL, result-null and rate gates."
    },
    {
      "id": "selector_slots",
      "requirement": "Prove each types slot determines the exact Class slot and the corresponding value conversion in the same-index argument slot; allocation lengths and loop bounds must agree."
    },
    {
      "id": "lookup_anchor",
      "requirement": "Class.getMethod must use target.getClass(), selected name and that same Class array. Enumerate only that proven receiver hierarchy and parser-representable exact parameter signatures."
    },
    {
      "id": "sink_identity",
      "requirement": "Returned Method must reach Method.invoke using the same target allocation and argument array, possibly through a proven forwarding wrapper. A wrapper with replacement logic needs branch-qualified sink evidence."
    },
    {
      "id": "virtual_resolution",
      "requirement": "For nonstatic members resolve actual target dispatch and most-specific override; keep declaring implementation separate from actual receiver."
    },
    {
      "id": "async_capture",
      "requirement": "If scheduled, establish runnable Method/array capture and enclosing-router target identity; scheduling must itself be reachable."
    },
    {
      "id": "failure_separation",
      "requirement": "Lookup null, parse errors and CommonAbility fallback do not certify successful invocation of the selected reflective member."
    },
    {
      "id": "transport_identity",
      "requirement": "Use actual prompt entry + WebView + router/target provenance. No native addJavascriptInterface registration name exists here; null means not applicable, not unknown."
    }
  ],
