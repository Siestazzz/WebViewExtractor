  },
  "boundaries": {
    "parse_failure": "Malformed JSON or required missing keys exits through exception handling; error callback may remain, selected member not proven invoked.",
    "unknown_type": "Leaves Class and Object slots unset; no exact selector certificate. Do not widen to all public methods.",
    "function": "Creates JavascriptCallback but leaves Class[i] and Object[i] unset; does not make callback-parameter members reachable.",
    "arity": "N=types.length; Class[N],Object[N],loop N. No explicit args.length equality. Extra args ignored; missing nullable string/object can map null; numeric/boolean/function indexed getter may fail.",
    "nullable": "String/JSONObject target parameter identity remains exact even for null argument values.",
    "covariant": "Lookup key has name+parameter types, not return type. Resolve effective method and any bridge duplicates according to platform lookup/virtual semantics; never expose each return variant independently. No Novel-specific covariant case asserted.",
    "override": "Novel subclass setStatusBarColor(int) overrides parent without super; parent body is not an independent dispatch target.",
    "static": "Public static members are not filtered in source. Method.invoke ignores receiver for static execution, but lookup still anchored in actual target Class. No blanket synthetic/static exclusion.",
    "annotation": "No exposure annotation predicate at getMethod. SyncMethod controls async selection only; unannotated public methods with representable exact signatures remain eligible.",
    "constructor": "Constructors are not getMethod members; private/protected/package methods are not public lookup candidates.",
    "platform_inherited": "Object inherited public surface not yet fully audited; retain explicit unresolved scope instead of annotation-based exclusion.",
    "monitor": "Packaged declaring-class replacement keys omit script hierarchy; ordinary fallback is evidenced. Registry is mutable public Map/list and hotpatch paths exist, so packaged/no dynamic replacement condition must stay explicit."
  },
